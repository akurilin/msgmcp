# Copy to .env (untracked) and replace the sample values. Nothing here is needed to build
# or to run scripts/smoke.py. The values below are made up but shaped like real ones.

# --- Scripts on the Mac -------------------------------------------------------------------

# scripts/reinstall.py: the certificate that signs msgmcp.app, so macOS keeps its Full Disk
# Access across builds. List yours with `security find-identity -v -p codesigning`. Optional:
# --sign overrides it, and without either the installed app's certificate is reused.
MSGMCP_SIGN_IDENTITY="Apple Development: jane@example.com (A1B2C3D4E5)"

# scripts/send_e2e.py --send: the one real recipient of the hand-run send test, in E.164.
# It must be saved in Contacts.
MSGMCP_TEST_RECIPIENT=+15551234567

# --- A cloud agent (agent/msgmcp.sh) -------------------------------------------------------
# These go in the agent's environment on its platform; a sandbox never sees this file. They
# are here so you know what to set, and to keep your values in one place.

# The gateway's tailnet address: the Mac's MagicDNS name, behind `tailscale serve`.
MSGMCP_URL=https://my-mac.tail4f2e1c.ts.net/mcp

# Secret. A reusable, ephemeral Tailscale auth key tagged tag:agent
# (Tailscale admin console → Settings → Keys).
TS_AUTHKEY=tskey-auth-REPLACE-WITH-YOUR-KEY

# Secret. The gateway's bearer token, 64 hex characters. Copy it without printing it:
#   pbcopy < "$HOME/Library/Application Support/MSGMCP/gateway.token"
MSGMCP_TOKEN=3f9a1c7e5b2d4f6081a3c5e7f9b1d3f5a7c9e1b3d5f7091a2b4c6d8e0f1a3b5c

# Optional. The sandbox's name on the tailnet and in the audit log (default msgmcp-agent).
MSGMCP_AGENT_HOSTNAME=msgmcp-agent
